# --- source systems (as provided by the instructor for this team's tenant) ---
SIS_URL=http://127.0.0.1:8001
LMS_URL=http://127.0.0.1:8002

# --- tenant & credentials ---
TENANT_ID=TEAM01
SIS_CLIENT_ID=WEB-CONSOLE
SIS_CLIENT_SECRET=student-secret
LMS_CLIENT_ID=WEB-CONSOLE
LMS_CLIENT_SECRET=student-secret

# --- own datastore (never points at SIS/LMS databases) ---
INTEGRATION_DB_URL=sqlite:////app/data/integration.db

# --- operating mode: "poll" (default, robust) or "webhook" ---
INTEGRATION_MODE=poll
PUBLIC_CALLBACK_BASE_URL=http://127.0.0.1:8000
POLL_INTERVAL_SECONDS=3
RETRY_WORKER_INTERVAL_SECONDS=2

# --- retry / backoff (NFR-02 / NFR-03) ---
MAX_RETRIES=6
BACKOFF_BASE_SECONDS=2
BACKOFF_MAX_SECONDS=60
HTTP_TIMEOUT_SECONDS=10

# --- startup behaviour ---
AUTO_BOOTSTRAP_ON_START=true
AUTO_RESET_ON_START=false
ADMIN_KEY=admin-secret

LOG_LEVEL=INFO
